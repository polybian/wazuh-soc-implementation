# Copy to .env and replace EVERY placeholder BEFORE first `docker compose up`.
#
# Generate each password with:
#   openssl rand -base64 24
# Wazuh password rules: letters/numbers plus . - _ only, 8-64 chars
# (regenerate if base64 output gives you + / or =).
#
# NOTE: INDEXER_PASSWORD and DASHBOARD_PASSWORD are the real passwords stored
# inside the Wazuh indexer's user database. On first boot the indexer still
# has its default passwords, so EITHER set these to the indexer defaults on
# first boot and rotate afterwards, OR pre-seed rotated hashes as described
# in docs/architecture.md ("Password rotation"). The manager, dashboard,
# and API only *present* these values — they don't create the accounts.

# Indexer 'admin' user — used by manager (Filebeat) and dashboard to
# read/write alerts; also the initial dashboard login.
INDEXER_PASSWORD=<generate-your-own>

# Indexer 'kibanaserver' user — dashboard's internal account.
DASHBOARD_PASSWORD=<generate-your-own>

# Wazuh API user 'wazuh-wui' — dashboard <-> manager integration account.
API_PASSWORD=<generate-your-own>

# Agent enrollment (authd) password — agents must present this to register.
# Also store it in the manager at /var/ossec/etc/authd.pass (see runbook).
WAZUH_REGISTRATION_PASSWORD=<generate-your-own>
